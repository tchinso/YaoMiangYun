<Window x:Class="YaoVpn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yao VPN" Icon="Assets/AppIcon.ico" Width="950" Height="760" MinWidth="860" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1422" Foreground="#EDF3F8"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AppLogo" Width="36" Height="36" Background="#173B38" CornerRadius="11" Margin="0,0,11,0"><Path Data="M 19 7 L 29 11 L 29 20 C 29 26 24 30 19 33 C 14 30 9 26 9 20 L 9 11 Z" Stroke="#69E3C2" StrokeThickness="1.8" Stretch="Uniform" Width="18" Height="23"/></Border>
                <TextBlock Text="Yao VPN" FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="시작은 항상 OFF" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <Button x:Name="RulesWindowButton" Content="사이트 규칙 · 통신 로그 ↗" Click="RulesWindowButton_Click" HorizontalAlignment="Right" Padding="15,10" AutomationProperties.Name="사이트 규칙 및 통신 로그 창 열기"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,17,0,17"><TextBlock Text="연결할 서버와 실제 출구를 한눈에." FontSize="21" FontWeight="SemiBold"/><TextBlock Text="서버 이름의 국가는 공급자 표시입니다. 연결 후 실제 VPN 출구 국가를 따로 확인합니다." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Background="#142135" BorderBrush="#24334A" BorderThickness="1" CornerRadius="18" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#91A1B7" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="StatusLabel" Text="VPN 꺼짐" FontSize="12" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                    <Button x:Name="PowerButton" Grid.Row="1" Width="132" Height="132" Margin="0,11,0,10" VerticalAlignment="Center" Click="PowerButton_Click" AutomationProperties.Name="VPN 켜기" ToolTip="선택한 서버로 VPN 연결" Background="#1A2B40" BorderBrush="#41536A" BorderThickness="2">
                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="PowerSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="72"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                        <StackPanel><Grid Width="36" Height="37" Margin="0,0,0,10"><Path x:Name="PowerArc" Data="M 9 7 A 15 15 0 1 0 27 7" Stroke="#A7B8CD" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="PowerLine" Data="M 18 1 L 18 17" Stroke="#A7B8CD" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid><TextBlock x:Name="PowerText" Text="OFF" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#C7D3E2"/></StackPanel>
                    </Button>
                    <StackPanel Grid.Row="2"><TextBlock x:Name="ConnectionTitle" Text="연결할 준비가 되었어요" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="MessageText" Text="구독 주소를 입력해 서버를 불러오세요." Foreground="{StaticResource MutedBrush}" LineHeight="19" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" MinHeight="38"/></StackPanel>
                    <TextBlock Grid.Row="3" Text="끄면 이전 네트워크 설정으로 복원합니다." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#111E30" BorderBrush="#24334A" BorderThickness="1" CornerRadius="18" Padding="21,17">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="연결 방식" FontSize="14" FontWeight="SemiBold"/><ComboBox x:Name="ConnectionModeBox" SelectedIndex="0" Margin="0,7,0,0" SelectionChanged="ConnectionModeBox_SelectionChanged" AutomationProperties.Name="VPN 연결 방식"><ComboBoxItem Content="앱 프록시 · 관리자 권한 없음"/><ComboBoxItem Content="전체 시스템 TUN · 관리자 권한 필요"/></ComboBox><TextBlock x:Name="ConnectionModeHint" Text="프록시 사용 앱의 TCP만 적용 · UDP/게임은 일반 통신" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,13,0,0"><TextBlock Text="연결할 서버" FontSize="14" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ServerBox" Margin="0,7,0,0" DisplayMemberPath="DisplayName" SelectionChanged="ServerBox_SelectionChanged" AutomationProperties.Name="VPN 서버 선택" ToolTip="남은 사용량 → 일본 → 중국·홍콩 → 싱가포르 → 기타 순서"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsConnectable}"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.58"/></Trigger></Style.Triggers></Style></ComboBox.ItemContainerStyle></ComboBox>
                        <TextBlock x:Name="ServerHint" Text="아직 불러온 서버가 없습니다." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/><TextBlock x:Name="ServerRegionText" Text="연결할 서버를 선택하세요." Foreground="#C7D3E2" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,13,0,0"><TextBlock Text="HTTPS 구독 주소" FontSize="14" FontWeight="SemiBold"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="SubscriptionBox" Background="#0D1929" Foreground="#EDF3F8" BorderBrush="#34455E" BorderThickness="1" Padding="10,10" FontSize="13" PasswordChar="●" AutomationProperties.Name="구독 주소 (숨김)" ToolTip="구독 주소는 화면에서 숨겨집니다"/><Button x:Name="RefreshButton" Grid.Column="1" Content="불러오기" Click="RefreshButton_Click" Padding="13,9" Margin="8,0,0,0" Background="#69E3C2" Foreground="#102C2A" BorderBrush="#69E3C2"/></Grid></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#111E30" BorderBrush="#24334A" BorderThickness="1" CornerRadius="12" Padding="16,13" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Top" Margin="0,0,15,0"><Button x:Name="IpButton" Content="VPN 출구 · 국가 확인" Click="IpButton_Click" Padding="13,9" ToolTip="사용자의 사이트 규칙과 독립적으로 실제 VPN 출구 국가를 확인합니다"/><Button x:Name="TestButton" Content="연결 테스트" Click="TestButton_Click" Padding="13,8" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="IpResultText" Text="연결 후 실제 VPN IP·국가를 자동 확인합니다." Foreground="#C7D3E2" FontSize="12" TextWrapping="Wrap" LineHeight="19" MinHeight="58"/><TextBlock x:Name="TestResultText" Text="연결 후 확인할 수 있어요" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid></Border>
        <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="공급자 앱·스크립트·루트 인증서를 설치하지 않습니다." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="보안 안내" Click="SecurityButton_Click" Padding="12,7" FontSize="11"/></Grid>
    </Grid>
</Window>
