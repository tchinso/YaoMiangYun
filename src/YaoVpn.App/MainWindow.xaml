<Window x:Class="YaoVpn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yao VPN" Width="940" Height="790" MinWidth="820" MinHeight="730"
        WindowStartupLocation="CenterScreen" Background="#0B1422" Foreground="#EDF3F8"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A1B7"/>
        <SolidColorBrush x:Key="MintBrush" Color="#69E3C2"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EDF3F8"/>
            <Setter Property="Background" Value="#223149"/>
            <Setter Property="BorderBrush" Value="#34455E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#69E3C2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EDF3F8"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#293C54"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#23483F"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDF3F8"/>
            <Setter Property="Background" Value="#0D1929"/>
            <Setter Property="BorderBrush" Value="#34455E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#0D1929" BorderBrush="#34455E" BorderThickness="1" CornerRadius="9">
                                            <Path Data="M 0 0 L 5 5 L 10 0" Stroke="#91A1B7" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="13,13,36,13" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="#142236" BorderBrush="#34455E" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="260" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#69E3C2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#173B38" CornerRadius="12" Margin="0,0,12,0">
                        <Path Data="M 19 7 L 29 11 L 29 20 C 29 26 24 30 19 33 C 14 30 9 26 9 20 L 9 11 Z"
                              Stroke="#69E3C2" StrokeThickness="1.8" Stretch="Uniform" Width="19" Height="24"/>
                    </Border>
                    <TextBlock Text="Yao VPN" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#162236" CornerRadius="12" Padding="11,5">
                    <TextBlock Text="시작은 항상 OFF" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,26,0,22">
                <TextBlock Text="연결은 간단하게, 제어는 직접." FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="구독을 불러오고 서버를 선택한 뒤 VPN을 켜세요." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                <Border Background="#142135" BorderBrush="#24334A" BorderThickness="1" CornerRadius="20" Padding="26,27">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#91A1B7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StatusLabel" Text="VPN 꺼짐" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Button x:Name="PowerButton" Grid.Row="1" Width="148" Height="148" Margin="0,25,0,22"
                                Click="PowerButton_Click" AutomationProperties.Name="VPN 켜기" ToolTip="선택한 서버로 VPN 연결"
                                Background="#1A2B40" BorderBrush="#41536A" BorderThickness="2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PowerSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="74">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.83"/></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.65"/></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="White"/></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.4"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <Grid Width="36" Height="37" Margin="0,0,0,11">
                                    <Path x:Name="PowerArc" Data="M 9 7 A 15 15 0 1 0 27 7" Stroke="#A7B8CD" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path x:Name="PowerLine" Data="M 18 1 L 18 17" Stroke="#A7B8CD" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                                <TextBlock x:Name="PowerText" Text="OFF" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#C7D3E2"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="ConnectionTitle" Text="연결할 준비가 되었어요" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MessageText" Text="구독 주소를 입력해 서버를 불러오세요." Foreground="{StaticResource MutedBrush}"
                                       LineHeight="21" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MinHeight="62"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Margin="0,24,0,0">
                            <Border Height="1" Background="#2A394D" Margin="0,0,0,18"/>
                            <TextBlock Text="꺼지면 일반 인터넷으로 돌아갑니다" Foreground="#C6D2DF" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="VPN 종료 · 코어 중단 시 자동 복구" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#111E30" BorderBrush="#24334A" BorderThickness="1" CornerRadius="20" Padding="26,26">
                    <StackPanel>
                        <TextBlock Text="연결할 서버" FontSize="16" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ServerBox" Margin="0,14,0,0" DisplayMemberPath="DisplayName" SelectionChanged="ServerBox_SelectionChanged"
                                  AutomationProperties.Name="VPN 서버 선택" ToolTip="구독에서 불러온 서버를 선택하세요"/>
                        <TextBlock x:Name="ServerHint" Text="아직 불러온 서버가 없습니다." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,9,0,0" MinHeight="38"/>
                        <Border Background="#26364A" Height="1" Margin="0,17,0,21"/>
                        <TextBlock Text="구독 주소" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="HTTPS 구독 링크를 붙여넣으세요." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,10"/>
                        <PasswordBox x:Name="SubscriptionBox" Background="#0D1929" Foreground="#EDF3F8" BorderBrush="#34455E"
                                     BorderThickness="1" Padding="12,12" FontSize="14" PasswordChar="●"
                                     AutomationProperties.Name="구독 주소 (숨김)" ToolTip="구독 주소는 화면에서 숨겨집니다"/>
                        <Button x:Name="RefreshButton" Content="구독 불러오기 / 새로고침" Click="RefreshButton_Click" Margin="0,12,0,0"
                                Background="#69E3C2" Foreground="#102C2A" BorderBrush="#69E3C2"/>
                        <TextBlock Text="주소는 화면에 표시되지 않습니다." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0"/>
                        <Grid Margin="0,25,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="TestButton" Content="연결 테스트" Padding="13,10" Click="TestButton_Click" ToolTip="VPN 연결 후 인터넷 응답을 확인합니다"/>
                            <TextBlock x:Name="TestResultText" Grid.Column="1" Text="연결 후 확인할 수 있어요" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Text="구독 제공자의 앱이나 스크립트를 실행하지 않습니다." Foreground="#A9B8CB" FontSize="12" HorizontalAlignment="Center"/>
                <Expander Header="사용 전 알아둘 점" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,0" HorizontalContentAlignment="Stretch">
                    <Border Background="#111E30" CornerRadius="9" Padding="14,12" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" LineHeight="20">
                            연결에 사용하는 코어와 Windows 자체에 취약점이 있을 수 있으며, 악성코드가 없다고 보장할 수는 없습니다.<LineBreak/>
                            영구 킬 스위치를 사용하지 않습니다. VPN을 끄거나 코어가 중단되면 일반 인터넷 연결로 돌아갑니다.
                        </TextBlock>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
